# AlwyChat web version: static files only (the app runs in the browser).
# Settings (environment variables):
#   DEFAULT_MATRIX_SERVER  the homeserver the sign-in screen suggests, e.g. example.org
#                          (default: matrix.org)
#   ALWY_ADDRESS           where to listen: ":80" (default, plain http behind your reverse
#                          proxy), or a domain like "chat.example.org" for automatic https
#   ALWY_TLS               e.g. "tls internal" for a local https test
{$ALWY_ADDRESS::80} {
	{$ALWY_TLS}
	root * /srv
	encode zstd gzip

	header {
		# The page's own Content-Security-Policy is in index.html (it needs a hash of
		# SvelteKit's start script); this one adds what a <meta> tag can't do.
		Content-Security-Policy "frame-ancestors 'none'"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(self), display-capture=(self)"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		-Server
	}
	# File names with a content hash never change.
	header /_app/immutable/* Cache-Control "public, max-age=31536000, immutable"
	# Always fresh, so updates reach everyone.
	header /index.html Cache-Control "no-cache"
	header /media-sw.js Cache-Control "no-cache"

	# This site's settings, read by the app at start (empty = the app's own default).
	handle /config.json {
		header Content-Type application/json
		header Cache-Control "no-cache"
		respond `{"default_server":"{$DEFAULT_MATRIX_SERVER}"}` 200
	}

	handle {
		try_files {path} /index.html
		# scripts/finish-web.mjs writes Brotli copies (.br, best level) of the build: sent as
		# they are to browsers that take Brotli (~30 % smaller than compressing on the fly).
		file_server {
			precompressed br
		}
	}
}
