{
  "name": "AlwyChat",
  "short_name": "AlwyChat",
  "description": "A chat app for Matrix",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0e1014",
  "theme_color": "#5B5BD6",
  "icons": [
    {
      "src": "favicon.svg",
      "sizes": "any",
